# ---- Server environment. NEVER commit the real .env ----

NODE_ENV=development
PORT=4000

# Comma-separated list of browser origins allowed to call this API.
# In dev the Vite proxy makes requests same-origin, so this is a fallback.
CLIENT_ORIGIN=http://localhost:5173

# ============================================================
#  Supabase
#  Dashboard -> Project Settings -> API Keys
#
#  Supabase renamed these keys. If the page shows the new names:
#     sb_publishable_...  ->  SUPABASE_ANON_KEY
#     sb_secret_...       ->  SUPABASE_SERVICE_ROLE_KEY
#  The old JWT-style keys are under "Legacy API keys" on the same page.
# ============================================================

# Your project ref is in the dashboard URL: /project/<ref>
SUPABASE_URL=https://rdwhymcptsxzlnqzoqzq.supabase.co

# Safe to expose. Respects row-level security.
SUPABASE_ANON_KEY=

# Bypasses row-level security. Server-side only - never in client/ and never
# in a VITE_ variable, since everything VITE_ is compiled into the public bundle.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
#  Postgres
#  Green "Connect" button at the top of the dashboard -> Session pooler
#
#  Pick SESSION POOLER (port 5432 on *.pooler.supabase.com), not "Direct
#  connection": direct is IPv6-only without the paid IPv4 add-on, so it fails
#  from most networks and from Render.
#
#  Shape:  postgresql://postgres.<ref>:<password>@aws-N-<region>.pooler.supabase.com:5432/postgres
#  Copy the host verbatim from the Connect dialog - the aws-N prefix varies.
#
#  Forgot the database password? Project Settings -> Database ->
#  Reset database password. It is shown once at project creation only.
#  URL-encode any special characters in it (@ -> %40, # -> %23).
# ============================================================
DATABASE_URL=
